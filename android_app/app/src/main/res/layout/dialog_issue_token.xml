<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Walk-in OPD Token"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Select patient and emergency flags"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Patient Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Patient Full Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lakshya Sharma" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Family Member Relationship Dropdown -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Booking For"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spFamilyMember"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/btn_dropdown" />

    <!-- Senior Citizen / Priority Emergency Checkbox -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Senior Citizen / Priority Emergency Ticket"
        android:textColor="#DC2626"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/priorityReasonLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="Priority Reason (e.g. Age 65+ / Chest Pain)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPriorityReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senior Citizen Priority" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#0E7C86"
        android:text="Confirm OPD Token Booking"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:cornerRadius="10dp" />

</LinearLayout>
