<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E7C86"
    android:padding="24dp">

    <!-- Top Badge -->
    <LinearLayout
        android:id="@+id/llTopTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_badge_teal"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ REALTIME WALK-IN OPD QUEUE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Hero Branding -->
    <LinearLayout
        android:id="@+id/llCenterBranding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- App Logo Icon -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:elevation="12dp"
            android:contentDescription="Hospital Qswift Logo"
            android:src="@drawable/ic_app_logo" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hospital Qswift"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- App Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Grab OPD Doctor Tokens remotely &amp; track your live queue position in real time."
            android:textColor="#E6F4F5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Actions & Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/splashProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="true"
            android:progressTint="#E8A33D"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/tvSplashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Syncing Live OPD Queue &amp; Doctor Tokens..."
            android:textColor="#C2E5E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEnterApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFFFFF"
            android:text="Enter App Now →"
            android:textAllCaps="false"
            android:textColor="#0E7C86"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</RelativeLayout>
